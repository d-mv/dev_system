FROM debian:stable-slim

RUN apt-get update && apt-get install -y \
  inetutils-ping zsh wget tmux vim neovim unzip git git-lfs fzf curl wget silversearcher-ag \
  make ruby sudo

RUN sh -c "$(curl --location https://taskfile.dev/install.sh)" -- -d

# fnm
RUN curl -fsSL https://fnm.vercel.app/install | bash -s -- --install-dir "/root/.fnm" --skip-shell
ENV PATH="/root/.fnm:$PATH"
RUN echo 'eval "$(fnm env --use-on-cd --shell zsh)"' >>~/.zshrc
# node
RUN fnm install 22 --resolve-engines --corepack-enabled
RUN fnm default 22
# pnpm
RUN wget -qO- https://get.pnpm.io/install.sh | ENV="$HOME/.zshrc" SHELL="$(which zsh)" zsh -
# zsh plugins
RUN git clone https://github.com/zsh-users/zsh-autosuggestions /etc/zsh/zsh-autosuggestions
RUN git clone https://github.com/zsh-users/zsh-history-substring-search /etc/zsh/zsh-history-substring-search
RUN git clone https://github.com/zdharma-continuum/fast-syntax-highlighting /etc/zsh/fsh
RUN curl https://raw.githubusercontent.com/d-mv/dotfiles/refs/heads/local/zsh/clean.zshrc >>~/.zshrc
RUN curl https://raw.githubusercontent.com/d-mv/dotfiles/refs/heads/local/tmux/tmux.conf >>~/.tmux.conf
RUN git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm
RUN echo "set -g @plugin 'tmux-plugins/tpm'" >>~/.tmux.conf
RUN echo "set -g @plugin 'tmux-plugins/tmux-sensible'" >>~/.tmux.conf
RUN echo "set -g @plugin 'arcticicestudio/nord-tmux'" >>~/.tmux.conf
RUN echo "run '~/.tmux/plugins/tpm/tpm'" >>~/.tmux.conf

RUN echo "alias kod='cd ~/code'" >>~/.zshrc

RUN chsh -s $(which zsh) $USER

ENTRYPOINT ["zsh"]
